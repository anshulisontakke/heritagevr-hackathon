# HeritageVR Backend Environment Variables

# Server
PORT=5000
NODE_ENV=development

# Database (SQLite for local dev, switch to PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# For PostgreSQL (production):
# DATABASE_URL="postgresql://username:password@localhost:5432/heritagevr?schema=public"

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Razorpay (Test/Sandbox Mode)
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Upload directory
UPLOAD_DIR=uploads
